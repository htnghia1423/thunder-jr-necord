# Discord bot token (REQUIRED)
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=

# PostgreSQL connection string (REQUIRED)
# Consumed by Prisma via @prisma/adapter-pg (see src/prisma/prisma.service.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/thunder

# Optional: restrict slash-command registration to a single guild for INSTANT
# updates while developing. Leave empty to register commands globally
# (global registration can take up to ~1 hour to propagate).
GUILD_ID=

# Optional: YouTube Data API key used by stats/search features
# (src/features/music/services/youtube-api.service.ts)
YOUTUBE_API_KEY=

# Optional: HTTP port for the Nest application (defaults to 3000)
PORT=3000
